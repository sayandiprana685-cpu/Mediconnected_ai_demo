# Copy to backend/.env — never commit real secrets.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/mediconnect_ai

JWT_ACCESS_SECRET=change-this-access-secret-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

INVITE_TOKEN_EXPIRES_HOURS=72
OTP_EXPIRES_MINUTES=10
BCRYPT_ROUNDS=12
APP_TZ=Asia/Kolkata

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="MediConnect AI <noreply@mediconnect.ai>"

# Optional extra browser origins (comma-separated). Native apps do not send Origin.
CORS_ORIGINS=

# Auth cookie attributes are derived automatically: NODE_ENV=production or
# Render's RENDER=true marker selects SameSite=None + Secure (required when the
# SPA and API sit on separate sites), anything else selects SameSite=Lax without
# Secure for local development. Set COOKIE_SAMESITE=none|lax only to override.
COOKIE_SAMESITE=

# Temporary diagnostics: logs whether mc_access/mc_refresh are present on a
# request and whether Set-Cookie was emitted. Never logs credential values.
AUTH_COOKIE_DEBUG=false

# Optional AI / maps / voice for the User App. Leave empty to use the built-in navigator.
AI_API_URL=
AI_API_KEY=
MAPS_API_KEY=
VOICE_API_URL=
VOICE_API_KEY=

# When SMTP is not configured, invitation emails are stored in a development outbox
# and printed to the API console so the demo journey can continue.
